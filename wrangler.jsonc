{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weppy-public-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weppy-public-bot",
