{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weppy-public-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin/*", "/telegram/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weppy-public-bot",
      "database_id": "425ec848-d1b2-4823-a9cc-443c77af800d"
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "observability": {"enabled": true}
}
