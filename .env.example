# Copy to .env and fill in (never commit .env)
GROQ_API_KEY=dummy
WHATSAPP_TOKEN=dummy
PHONE_NUMBER_ID=dummy
VERIFY_TOKEN=ubah-token-bebas-ini
PORT=5000
# Transport chat: meta (default), twilio (sandbox), atau d360 (360dialog sandbox)
WHATSAPP_BACKEND=meta
# Twilio sandbox (hanya jika WHATSAPP_BACKEND=twilio)
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 360dialog sandbox (hanya jika WHATSAPP_BACKEND=d360; tanpa daftar akun:
# kirim START via WA ke +551146733492 untuk dapat key)
# D360_API_KEY=xxxx
# Optional: comma-separated test sender, e.g. 62812xxxx
# SENDER_ALLOWLIST=
# Optional: override approved WhatsApp template names (each takes one
# {{1}} variable with the full summary). Defaults follow spec.md.
# TEMPLATE_FOLLOWUP_ID=followup_reminder_id
# TEMPLATE_RECAP_ID=daily_recap_id
# TEMPLATE_FOLLOWUP_EN=followup_reminder_en
# TEMPLATE_RECAP_EN=daily_recap_en
# Optional: override model names / API version
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3
# GRAPH_API_VERSION=v21.0
