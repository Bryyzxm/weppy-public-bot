# Copy to .env and fill in (never commit .env)
GROQ_API_KEY=dummy
WHATSAPP_TOKEN=dummy
PHONE_NUMBER_ID=dummy
VERIFY_TOKEN=ubah-token-bebas-ini
PORT=5000
# Optional: comma-separated test sender, e.g. 62812xxxx
# SENDER_ALLOWLIST=
# Optional: override approved WhatsApp template names (each takes one
# {{1}} variable with the full summary). Defaults follow spec.md.
# TEMPLATE_FOLLOWUP_ID=followup_reminder_id
# TEMPLATE_RECAP_ID=daily_recap_id
# TEMPLATE_FOLLOWUP_EN=followup_reminder_en
# TEMPLATE_RECAP_EN=daily_recap_en
# Optional: override model names / API version
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3
# GRAPH_API_VERSION=v21.0
